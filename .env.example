# ============================================================
# BizVision AI — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Application ───────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development
PYTHON_ENV=development

# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bizvision
POSTGRES_PASSWORD=bizvision123
POSTGRES_DB=bizvision
DATABASE_URL=postgresql+asyncpg://bizvision:bizvision123@postgres:5432/bizvision

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── JWT Authentication ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MinIO / S3 Storage ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_MODELS=model-artifacts
MINIO_BUCKET_DATA=training-data
MINIO_BUCKET_REPORTS=generated-reports

# ─── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_PREFIX=bizvision

# ─── Flower (Celery Monitoring) ────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# ─── AI/ML APIs (Optional — for Chatbot) ──────────────────
# At least one of these is required for the Financial Chatbot
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# LangSmith (Optional — for agent observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=bizvision-ai

# ─── HuggingFace ───────────────────────────────────────────
HUGGINGFACE_TOKEN=your-hf-token-here
HF_HOME=/app/model_cache

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=BizVision AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Monitoring (Optional) ─────────────────────────────────
GRAFANA_PASSWORD=admin123
PROMETHEUS_RETENTION_DAYS=15

# ─── Feature Flags ─────────────────────────────────────────
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_DOCS=true  # Set to false in production
ENABLE_3D_RENDERING=true
ENABLE_EXPERIMENTAL_AGENTS=false
