# The React-Three-Fiber / three.js ecosystem ships very strict peer ranges
# (e.g. postprocessing pins a narrow three.js window) that routinely conflict
# under npm's strict peer resolution. legacy-peer-deps makes install + `npm ci`
# deterministic. Revisit once the 3D dep matrix is consolidated (Phase 2).
legacy-peer-deps=true
save-exact=false
fund=false
audit=false
